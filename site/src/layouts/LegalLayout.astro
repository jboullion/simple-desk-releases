---
// Privacy policy and terms: a long-form page with the "last updated" date and contact from site.config.ts.
import BaseLayout from "./BaseLayout.astro";
import { siteConfig } from "../site.config";

interface Props {
  frontmatter: { title: string; description: string };
}
const { title, description } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <article class="prose mx-auto px-4 py-12 sm:px-6 sm:py-16">
    <h1>{title}</h1>
    <p class="text-sm text-fg-muted">Last updated {siteConfig.legalUpdated}</p>
    <slot />
    <hr />
    <h2>Contact</h2>
    <p>
      Questions about this page, or about Simple Desk in general: email
      <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
    </p>
  </article>
</BaseLayout>
