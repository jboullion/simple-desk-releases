---
// The Simple Desk mark: four tool tiles, one of them a sticky note (same drawing as the app icon).
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 72 72" class={className} aria-hidden="true" focusable="false">
  <rect width="72" height="72" rx="16" fill="#2F6FDE"></rect>
  <rect x="12" y="12" width="22" height="22" rx="5" fill="#FFFFFF"></rect>
  <path d="M43 12H60V26L52 34H43Q38 34 38 29V17Q38 12 43 12Z" fill="#FAC775"></path>
  <path d="M60 26H55Q52 26 52 29V34Z" fill="#EF9F27"></path>
  <rect x="12" y="38" width="22" height="22" rx="5" fill="#FFFFFF"></rect>
  <rect x="38" y="38" width="22" height="22" rx="5" fill="#FFFFFF"></rect>
</svg>
