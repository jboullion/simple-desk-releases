---
// A lucide icon from lucide-static (SVG markup as a string), sized and colored by CSS.
interface Props {
  svg: string;
  size?: number;
  class?: string;
  label?: string;
}
const { svg, size = 20, class: className = "", label } = Astro.props;
const a11y = label ? `role="img" aria-label="${label}"` : `aria-hidden="true"`;
const html = svg
  .replace(/<!--.*?-->/s, "")
  .replace(/\s(width|height|class)="[^"]*"/g, "")
  .replace("<svg", `<svg width="${size}" height="${size}" class="shrink-0 ${className}" ${a11y} focusable="false"`);
---

<Fragment set:html={html} />
