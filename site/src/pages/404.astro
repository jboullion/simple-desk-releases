---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/url";
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6 sm:py-32">
    <p class="text-sm font-semibold tracking-wide text-accent-high uppercase dark:text-accent">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-fg-strong sm:text-4xl">This page isn't here</h1>
    <p class="mt-4 text-lg text-fg-muted">
      It may have moved, or the link has a typo. Try one of these instead:
    </p>
    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      <li>
        <a href={url()} class="inline-flex rounded-lg bg-accent px-5 py-2.5 font-medium text-accent-fg no-underline hover:brightness-110">Home</a>
      </li>
      <li>
        <a href={url("download/")} class="inline-flex rounded-lg border border-border px-5 py-2.5 text-fg no-underline hover:bg-bg-muted">Download</a>
      </li>
      <li>
        <a href={url("docs/")} class="inline-flex rounded-lg border border-border px-5 py-2.5 text-fg no-underline hover:bg-bg-muted">Docs</a>
      </li>
    </ul>
  </section>
</BaseLayout>
